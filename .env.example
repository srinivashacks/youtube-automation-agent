# YouTube Automation Agent Environment Configuration
# Copy this file to .env and fill in your actual values

# AI Provider
# OPENAI_API_KEY=your-openai-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# MOONSHOT_API_KEY=your-kimi-api-key-here
# MIMO_API_KEY=your-mimo-api-key-here
# GLM_API_KEY=your-glm-api-key-here

# Cognitive Angle local narration
# Kokoro runs locally through the Python environment and does not use a TTS API.
KOKORO_VOICE=am_michael
KOKORO_SPEED=1.0
# Optional explicit path. Default assumes C:\AI\kokoro-env beside the project directory.
# KOKORO_PYTHON=C:\AI\kokoro-env\Scripts\python.exe

# Character reference used for consistent Gemini image generation
# CHARACTER_REFERENCE_IMAGE=C:\AI\youtube-automation-agent\data\character\character-reference.png
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional paid image providers
# OPENAI_IMAGE_MODEL=gpt-image-2
# REPLICATE_API_KEY=your-replicate-api-key-here

# FFmpeg (optional override; resolution order: FFMPEG_PATH > bundled ffmpeg-static > system PATH)
# FFMPEG_PATH=

# Application Settings
NODE_ENV=production
PORT=3456
LOG_LEVEL=info

# Channel Settings
CHANNEL_NAME=Cognitive Angle
DEFAULT_AUTHOR=Your Name
TARGET_AUDIENCE=Young adults and working professionals interested in self-improvement, psychology, personal finance, and investing

# YouTube Settings
YOUTUBE_REGION=IN
DEFAULT_PRIVACY_STATUS=private

# Content Settings
AUTO_SHORTEN_CONTENT=true
AUTO_ADD_BACKLINKS=true
PRESERVE_FORMATTING=true
AUTO_RESIZE_IMAGES=true
MAX_IMAGE_WIDTH=1280
MAX_IMAGE_HEIGHT=720
IMAGE_QUALITY=90

# Rate Limiting
GLOBAL_RATE_LIMIT_PER_HOUR=50
DEFAULT_DELAY_BETWEEN_POSTS=60000

# Security
API_KEY=

# Analytics & Monitoring
ENABLE_ANALYTICS=true
ANALYTICS_DB_PATH=./data/analytics.db

# File Upload Settings
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# Error Handling
RETRY_ATTEMPTS=3
RETRY_DELAY=5000
